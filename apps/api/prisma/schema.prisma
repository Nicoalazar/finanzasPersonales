generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TxType {
  INCOME
  EXPENSE
  TRANSFER
}
enum TxStatus {
  PENDING
  PAID
}
enum CategoryType {
  INCOME
  EXPENSE
}
enum AccountKind {
  CASH
  BANK
  WALLET
  INVESTMENT
}
enum ShareMode {
  PERCENT
  AMOUNT
}
enum Frequency {
  MONTHLY
  BIMONTHLY
  YEARLY
}
enum PayslipKind {
  MONTHLY
  SAC
}
enum SharedPayer {
  ME
  PARTNER
}
enum SharedSource {
  FORM
  MANUAL
}
enum Currency {
  ARS
  USD
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Account {
  id             String      @id @default(cuid())
  name           String
  kind           AccountKind @default(BANK)
  initialBalance Decimal     @default(0) @db.Decimal(14, 2)
  archived       Boolean     @default(false)
  transactions   Transaction[] @relation("TxAccount")
  incoming       Transaction[] @relation("TxToAccount")
  snapshots      BalanceSnapshot[]
  cards          CreditCard[]
  jobs           Job[]
}

model Category {
  id        String       @id @default(cuid())
  name      String
  type      CategoryType
  parentId  String?
  parent    Category?    @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[]   @relation("CategoryTree")
  color     String?
  icon      String?
  /// Categoría donde se registran los pagos de terceros; se descuenta del gasto para obtener el gasto neto.
  isReimbursement Boolean @default(false)
  transactions Transaction[]
  budgets   Budget[]
  purchases CardPurchase[]
  recurring RecurringExpense[]
  sharedKinds SharedKind[]

  @@unique([name, type])
}

model Transaction {
  id          String      @id @default(cuid())
  date        DateTime    @db.Date
  amount      Decimal     @db.Decimal(14, 2)
  type        TxType
  status      TxStatus    @default(PAID)
  description String      @default("")
  categoryId  String?
  category    Category?   @relation(fields: [categoryId], references: [id])
  accountId   String
  account     Account     @relation("TxAccount", fields: [accountId], references: [id])
  toAccountId String?
  toAccount   Account?    @relation("TxToAccount", fields: [toAccountId], references: [id])
  recurringId String?
  recurring   RecurringExpense? @relation(fields: [recurringId], references: [id])
  payslipId   String?
  payslip     Payslip?    @relation(fields: [payslipId], references: [id])
  statementId String?
  statement   CardStatement? @relation(fields: [statementId], references: [id])
  /// true si el monto se editó a mano: la generación de recurrentes ya no lo pisa.
  amountLocked Boolean @default(false)
  personPaymentId String? @unique
  personPayment   PersonPayment? @relation(fields: [personPaymentId], references: [id], onDelete: Cascade)
  /// Mi pago de un gasto compartido: sale de caja, pero en categorías cuenta solo mi parte.
  sharedExpenseId String? @unique
  sharedExpense   SharedExpense? @relation(fields: [sharedExpenseId], references: [id], onDelete: Cascade)
  /// Saldo de gastos compartidos de ese mes (YYYY-MM) que me pagaron o que pagué.
  sharedMonth String?
  /// Mes (YYYY-MM) al que se imputa; evita duplicar recurrentes.
  period      String
  createdAt   DateTime    @default(now())

  @@index([period])
  @@unique([recurringId, period])
}

model CreditCard {
  id            String   @id @default(cuid())
  name          String
  closingDay    Int
  dueDay        Int
  stampTaxRate  Decimal  @default(0.007) @db.Decimal(6, 4)
  isThirdParty  Boolean  @default(false)
  payAccountId  String?
  payAccount    Account? @relation(fields: [payAccountId], references: [id])
  purchases     CardPurchase[]
  statements    CardStatement[]
}

model CardPurchase {
  id          String   @id @default(cuid())
  cardId      String
  card        CreditCard @relation(fields: [cardId], references: [id])
  date        DateTime @db.Date
  description String
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  /// En la moneda de `currency`. Las compras USD son siempre en un solo pago.
  totalAmount Decimal  @db.Decimal(14, 2)
  currency    Currency @default(ARS)
  /// Dólar oficial al cargar la compra; solo sirve hasta que el resumen tiene su cotización real.
  usdRateEstimate Decimal? @db.Decimal(14, 4)
  installmentCount Int @default(1)
  firstStatementMonth String
  installments CardInstallment[]
  shares      PersonShare[]
  /// Compra hecha para un gasto compartido: en categorías cuenta solo mi parte.
  sharedExpenseId String? @unique
  sharedExpense   SharedExpense? @relation(fields: [sharedExpenseId], references: [id], onDelete: Cascade)
}

model CardInstallment {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   CardPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  number     Int
  month      String
  amount     Decimal  @db.Decimal(14, 2)

  @@index([month])
}

model CardStatement {
  id         String   @id @default(cuid())
  cardId     String
  card       CreditCard @relation(fields: [cardId], references: [id])
  month      String
  adjustment Decimal  @default(0) @db.Decimal(14, 2)
  refunds    Decimal  @default(0) @db.Decimal(14, 2)
  /// Cotización del dólar que aplicó el banco en este resumen (la del PDF); null hasta cargarla.
  usdRate    Decimal? @db.Decimal(14, 4)
  /// Fechas reales de ese resumen; si son null se usan closingDay/dueDay de la tarjeta.
  closingDate DateTime? @db.Date
  dueDate     DateTime? @db.Date
  paidAt     DateTime?
  transactions Transaction[]

  @@unique([cardId, month])
}

model Person {
  id       String   @id @default(cuid())
  name     String   @unique
  shares   PersonShare[]
  charges  PersonCharge[]
  payments PersonPayment[]
  groups   SharedGroup[]
}

model PersonShare {
  id          String   @id @default(cuid())
  personId    String
  person      Person   @relation(fields: [personId], references: [id])
  purchaseId  String?
  purchase    CardPurchase? @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  recurringId String?
  recurring   RecurringExpense? @relation(fields: [recurringId], references: [id], onDelete: Cascade)
  mode        ShareMode
  value       Decimal  @db.Decimal(14, 2)
}

model PersonCharge {
  id          String   @id @default(cuid())
  personId    String
  person      Person   @relation(fields: [personId], references: [id])
  description String
  totalAmount Decimal  @db.Decimal(14, 2)
  installmentCount Int @default(1)
  firstMonth  String
}

model PersonPayment {
  id       String   @id @default(cuid())
  personId String
  person   Person   @relation(fields: [personId], references: [id])
  date     DateTime @db.Date
  amount   Decimal  @db.Decimal(14, 2)
  note     String   @default("")
  transaction Transaction?
}

model SharedGroup {
  id        String @id @default(cuid())
  name      String @unique
  /// Porcentaje base; cada mes puede tener el suyo (SharedGroupPercent) y se hereda hacia adelante.
  myPercent Decimal @db.Decimal(5, 2)
  /// Con quién se comparte el grupo: lo recurrente del grupo lo pago entero yo y esta persona me debe lo que no es mi %.
  personId  String?
  person    Person? @relation(fields: [personId], references: [id], onDelete: SetNull)
  recurring RecurringExpense[]
  overrides SharedGroupPercent[]
  ledgers   SharedLedger[]
}

model SharedGroupPercent {
  id      String  @id @default(cuid())
  groupId String
  group   SharedGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  month   String
  percent Decimal @db.Decimal(5, 2)

  @@unique([groupId, month])
}

/// Mes salteado a propósito: la generación no vuelve a crear ese pendiente.
model RecurringSkip {
  id          String @id @default(cuid())
  recurringId String
  recurring   RecurringExpense @relation(fields: [recurringId], references: [id], onDelete: Cascade)
  period      String

  @@unique([recurringId, period])
}

model RecurringExpense {
  id            String   @id @default(cuid())
  name          String
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])
  frequency     Frequency @default(MONTHLY)
  accountId     String?
  sharedGroupId String?
  sharedGroup   SharedGroup? @relation(fields: [sharedGroupId], references: [id])
  startMonth    String
  endMonth      String?
  dayOfMonth    Int      @default(1)
  skips         RecurringSkip[]
  prices        RecurringPriceChange[]
  shares        PersonShare[]
  transactions  Transaction[]
}

model RecurringPriceChange {
  id          String   @id @default(cuid())
  recurringId String
  recurring   RecurringExpense @relation(fields: [recurringId], references: [id], onDelete: Cascade)
  fromMonth   String
  amount      Decimal  @db.Decimal(14, 2)

  @@unique([recurringId, fromMonth])
}

model Budget {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  month      String
  amount     Decimal  @db.Decimal(14, 2)

  @@unique([categoryId, month])
}

model BalanceSnapshot {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  date      DateTime @db.Date
  balance   Decimal  @db.Decimal(14, 2)

  @@unique([accountId, date])
}

/// Un trabajo del que cobro sueldo. "informal" = en negro: no hay bruto, solo el neto (suele cobrarse en efectivo).
model Job {
  id        String    @id @default(cuid())
  name      String    @unique
  informal  Boolean   @default(false)
  /// cuenta donde se cobra por defecto
  accountId String?
  account   Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  archived  Boolean   @default(false)
  payslips  Payslip[]
}

/// Recibo de sueldo simplificado: solo bruto y neto (sin bruto si el trabajo es en negro). El ingreso se genera por el neto.
model Payslip {
  id    String      @id @default(cuid())
  jobId String
  job   Job         @relation(fields: [jobId], references: [id])
  month String
  kind  PayslipKind @default(MONTHLY)
  gross Decimal?    @db.Decimal(14, 2)
  net   Decimal     @db.Decimal(14, 2)
  transactions Transaction[]

  @@unique([jobId, month, kind])
}

/// Configuración de la libreta de gastos compartidos (una sola fila, id "default").
model SharedLedger {
  id               String   @id @default("default")
  groupId          String?
  group            SharedGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  meName           String   @default("Yo")
  partnerName      String   @default("Pareja")
  /// CSV publicado de la planilla de respuestas del formulario.
  sourceUrl        String?
  /// Las respuestas anteriores a este mes no se importan.
  fromMonth        String
  defaultAccountId String?
  lastSyncAt       DateTime?
}

/// Tipo de gasto del formulario ("Mercadería", "Alquiler"...) → categoría propia.
model SharedKind {
  kind       String  @id
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
}

/// Gasto común (lo pagó cualquiera de los dos). Mis pagos generan el movimiento o la compra con tarjeta.
model SharedExpense {
  id          String       @id @default(cuid())
  date        DateTime     @db.Date
  month       String
  payer       SharedPayer
  kind        String
  description String       @default("")
  amount      Decimal      @db.Decimal(14, 2)
  source      SharedSource @default(MANUAL)
  /// Identifica la respuesta del formulario para no duplicarla al reimportar.
  externalKey String?      @unique
  /// Borrado a mano: no se vuelve a importar ni cuenta en el mes.
  ignored     Boolean      @default(false)
  accountId   String?
  cardId      String?
  installmentCount Int     @default(1)
  transaction Transaction?
  purchase    CardPurchase?
  createdAt   DateTime     @default(now())

  @@index([month])
}
